# ============================================================
# Alpaca paper-trading credentials
# Copy this file to .env locally and fill in real paper keys.
# Never commit the real .env file.
# ============================================================

APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
APCA_API_BASE_URL=https://paper-api.alpaca.markets

# ============================================================
# Run metadata / reproducibility
# ============================================================

RUN_VERSION=ppo_alpaca_six_ticker_v0_3
CONFIG_CHANGES="VS Code six-ticker paper-trading dry-run integration"
REASON_FOR_CHANGE="Integrate validated six-ticker PPO baseline into Alpaca paper-trading workflow"

# ============================================================
# Validated six-ticker universe
# ============================================================

TICKERS=AAPL,AMD,MRK,PFE,UNH,XOM

# ============================================================
# Feed / timeframe settings
# ============================================================

BARS_FEED=iex
DATA_TIMEFRAME=1H
TRAIN_TIMEFRAME=1H
EQUITY_TIMEFRAME=5Min

# ============================================================
# Safety defaults
# ============================================================

DRY_RUN=1
AUTO_RUN_LIVE=0
REQUIRE_PAPER=1
ALLOW_SHORTS=0
USE_FRACTIONALS=1

# ============================================================
# Sizing / signal thresholds
# ============================================================

WEIGHT_CAP=0.40
SIZING_MODE=linear
CONF_FLOOR=0.00

ENTER_CONF_MIN=0.02
ENTER_WEIGHT_MIN=0.002
EXIT_WEIGHT_MAX=0.001
REBALANCE_MIN_NOTIONAL=25.00

RAW_POS_MIN=0.00
RAW_NEG_MAX=0.00

# ============================================================
# Risk controls
# ============================================================

TAKE_PROFIT_PCT=0.05
STOP_LOSS_PCT=0.02

MAX_DAILY_DRAWDOWN_PCT=0.05
GROSS_CAP=1.00
NET_CAP=0.80
EMERGENCY_FLATTEN_ON_EXPOSURE=0

# ============================================================
# Market-close behavior
# ============================================================

FLATTEN_INTO_CLOSE=1
START_FLAT=0
EXIT_AFTER_CLOSE=1
FORCE_FLATTEN_ON_EXIT=1
CLOSE_FLATTEN_MINUTES=12
CLOSE_FLATTEN_TIMEOUT_SEC=180

# ============================================================
# Runtime controls
# ============================================================

COOLDOWN_MIN=10
STALE_MAX_SEC=4200
ORDER_TIMEOUT_SECONDS=90
RECONCILE_DRIFT_THRESHOLD=0.03
SYMBOL_STEP_TIMEOUT_SEC=150
