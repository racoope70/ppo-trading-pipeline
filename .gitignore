# Python cache/build files
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment variables / secrets
.env
*.env
.env.*
!.env.example

# OS / editor files
.DS_Store
Thumbs.db
.vscode/
.idea/

# Jupyter checkpoints
.ipynb_checkpoints/

# Local logs
logs/
*.log

# Data files generated locally
*.csv
*.parquet
*.pkl

# Model artifacts
models/
trained_models/
archived_colab_trained_models/

# Reports and generated outputs
reports/
*.png
*.jpg
*.jpeg
*.pdf

# QuantConnect generated/local state
QuantConnect_Ready/
live_signals.json
gist_metadata.json
live_signals_gist_id.txt

# Large ML/RL artifacts
*.zip
*.pt
*.pth
*.onnx
*.joblib
*.h5
*.keras

# Keep folder structure if you add .gitkeep files
!data/.gitkeep
!data/raw/.gitkeep
!data/processed/.gitkeep
!models/.gitkeep
!reports/.gitkeep
!logs/.gitkeep

# Generated/local data files
data/raw/*
data/processed/*
data/alpaca_historical/*
data/alpaca_training/*

# PPO v2 governed quarantine/log outputs
# Generated PPO v2 no-submit/quarantine outputs are local-only and must not be committed.
# This does not authorize PPO v2 training, data fetching, dataset generation, model artifact creation, or submit.
# Directory exceptions allow optional .gitkeep placeholders while keeping generated files ignored.
!artifacts/ppo_v2/quarantine/
artifacts/ppo_v2/quarantine/*
!artifacts/ppo_v2/quarantine/.gitkeep
!artifacts/ppo_v2/logs/
artifacts/ppo_v2/logs/*
!artifacts/ppo_v2/logs/.gitkeep
